"""# Clasificación multiclase (4 clases)
Se ajusta cada modelo con GridSearchCV (5 folds, métrica **F1 macro**). F1 macro promedia el F1 de cada clase con el mismo peso, por lo que no favorece a una clase sobre otra.
"""

def score_continuo(m, X):
    return m.predict_proba(X)[:, 1] if hasattr(m, "predict_proba") else m.decision_function(X)

modelos_clf = {
    "GNB": (GaussianNB(),
            {"var_smoothing": [1e-9, 1e-7, 1e-5]}),
    "DT": (DecisionTreeClassifier(random_state=SEED),
           {"max_depth": [3, 5, 8, 12, None], "min_samples_leaf": [1, 5, 20]}),
    "RF": (RandomForestClassifier(random_state=SEED, n_jobs=-1),
           {"n_estimators": [100, 300], "max_depth": [None, 10, 20], "min_samples_leaf": [1, 5]}),
    "SVM": (make_pipeline(StandardScaler(), SVC(kernel="rbf", random_state=SEED)),
            {"svc__C": [0.1, 1, 10], "svc__gamma": ["scale", 0.05, 0.1]}),
}

def busqueda_clf(modelos, Xtr, ytr, Xte, yte, binario):
    filas, ajustados, crudos = [], {}, {}
    scoring = "f1" if binario else "f1_macro"
    for nombre, (est, grid) in modelos.items():
        t0 = time.time()
        gs = GridSearchCV(est, grid, scoring=scoring, cv=cv_clf, n_jobs=-1, refit=True)
        gs.fit(Xtr, ytr)
        m = gs.best_estimator_
        pred = m.predict(Xte)
        fila = {
            "Modelo": nombre,
            "Hiperparámetros": {k.split("__")[-1]: v for k, v in gs.best_params_.items()},
            "CV media": round(gs.best_score_, 4),
            "CV desv. est.": round(gs.cv_results_["std_test_score"][gs.best_index_], 4),
        }
        if binario:
            fila.update({
                "Test accuracy": accuracy_score(yte, pred),
                "Test precision": precision_score(yte, pred),
                "Test recall": recall_score(yte, pred),
                "Test F1": f1_score(yte, pred),
                "Test ROC-AUC": roc_auc_score(yte, score_continuo(m, Xte)),
            })
        else:
            fila.update({
                "Test accuracy": accuracy_score(yte, pred),
                "Test balanced acc": balanced_accuracy_score(yte, pred),
                "Test F1 macro": f1_score(yte, pred, average="macro"),
                "Test F1 weighted": f1_score(yte, pred, average="weighted"),
                "Test kappa cuadrático": cohen_kappa_score(yte, pred, weights="quadratic"),
            })
        fila["Tiempo (s)"] = round(time.time() - t0, 1)
        filas.append(fila)
        ajustados[nombre] = m
        crudos[nombre] = gs.best_params_
    return pd.DataFrame(filas).set_index("Modelo"), ajustados, crudos

res_multi, modelos_multi, params_multi = busqueda_clf(modelos_clf, Xc_tr, y4_tr, Xc_te, y4_te, binario=False)
