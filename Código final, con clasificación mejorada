FEATURES_REG = [c for c in FEATURES_CLF if c != "grasa_pct"]   # grasa_pct es el target en regresión

idx_tr, idx_te = train_test_split(d.index, test_size=0.20, stratify=d["clase_ord"], random_state=SEED)

Xc_tr, Xc_te = d.loc[idx_tr, FEATURES_CLF], d.loc[idx_te, FEATURES_CLF]
